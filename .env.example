# Only non-sensitive values. Passwords and tokens come from external files.
COMPOSE_PROJECT_NAME=servirepuestos_gateway
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=gateway
POSTGRES_USER=gateway
SECRETS_DIR=../odoo20_servirepuestos_secrets/runtime/local
GATEWAY_IMAGE=servirepuestos-gateway:local
