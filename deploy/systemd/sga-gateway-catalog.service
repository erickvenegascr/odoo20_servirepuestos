[Unit]
Description=SGA Odoo application catalog
After=network-online.target sga-gateway-postgresql.service
Requires=sga-gateway-postgresql.service
[Service]
Type=oneshot
User=sgagateway
Group=sgagateway
WorkingDirectory=/opt/sga-gateway/app/gateway
EnvironmentFile=/etc/sga-gateway/gateway.env
ExecStart=/opt/sga-gateway/venv/bin/python manage.py sync_catalog --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
TimeoutStartSec=0
