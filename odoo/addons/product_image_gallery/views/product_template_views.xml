<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_image_gallery" model="ir.ui.view">
        <field name="name">product.template.form.image.gallery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Galería de imágenes" name="image_gallery">
                    <field name="gallery_image_ids" mode="kanban">
                        <kanban default_order="sequence, id" class="o_kanban_small_column">
                            <field name="name"/>
                            <field name="image_512"/>
                            <templates>
                                <t t-name="card">
                                    <field name="image_512" widget="image" class="w-100" options="{'size': [220, 180], 'img_class': 'object-fit-contain rounded'}"/>
                                    <div class="mt-2 text-truncate"><field name="name"/></div>
                                </t>
                            </templates>
                        </kanban>
                        <list editable="bottom" default_order="sequence, id">
                            <field name="sequence" widget="handle"/>
                            <field name="image_128" widget="image"/>
                            <field name="name"/>
                            <field name="active" optional="hide"/>
                        </list>
                        <form string="Imagen secundaria">
                            <sheet>
                                <group>
                                    <field name="image_1920" widget="image" options="{'zoom': True, 'size': [640, 480], 'img_class': 'object-fit-contain rounded'}"/>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="active"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
