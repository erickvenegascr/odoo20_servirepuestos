<odoo>
    <record id="application_list" model="ir.ui.view">
        <field name="name">sga.gateway.application.list</field>
        <field name="model">sga.gateway.application</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="company_id"/><field name="source_instance"/><field name="last_seen_at"/><field name="active"/></list>
        </field>
    </record>
    <record id="application_form" model="ir.ui.view">
        <field name="name">sga.gateway.application.form</field>
        <field name="model">sga.gateway.application</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_generate_token" type="object" string="Generar / rotar token" confirm="El token anterior dejará de funcionar. Copie el nuevo token al gateway."/><button name="action_revoke" type="object" string="Revocar acceso"/><button name="action_ping" type="object" string="Probar comunicación de regreso"/></header>
                <sheet><group><field name="name"/><field name="company_id"/><field name="source_instance"/><field name="application_uuid"/><field name="active"/><field name="catalog_enabled"/><field name="exchange_enabled"/><field name="token_changed_at"/><field name="last_seen_at"/></group>
                    <separator string="Bandeja Odoo hacia gateway"/>
                    <field name="message_ids"><list create="0" delete="0"><field name="create_date"/><field name="message_uuid"/><field name="kind"/><field name="state"/><field name="acknowledged_at"/><field name="result"/></list></field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="application_action" model="ir.actions.act_window"><field name="name">Aplicaciones SGA Gateway</field><field name="res_model">sga.gateway.application</field><field name="view_mode">list,form</field></record>
    <menuitem id="application_menu" name="Conexiones" parent="menu_sga_gateway" action="application_action" groups="base.group_system" sequence="1"/>
</odoo>
