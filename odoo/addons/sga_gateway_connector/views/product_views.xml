<odoo>
    <record id="product_template_form_sga_inactive" model="ir.ui.view">
        <field name="name">product.template.form.sga.inactive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="sga_catalog_article_id" invisible="1"/>
                <field name="sga_catalog_source_inactive" invisible="not sga_catalog_article_id"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_search_sga_inactive" model="ir.ui.view">
        <field name="name">product.template.search.sga.inactive</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter name="sga_source_inactive" string="Inactivos en SGA"
                        domain="[('sga_catalog_source_inactive', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
