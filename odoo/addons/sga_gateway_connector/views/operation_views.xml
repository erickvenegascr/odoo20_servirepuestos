<odoo>
  <record id="view_sga_gateway_operation_list" model="ir.ui.view">
    <field name="name">sga.gateway.operation.list</field>
    <field name="model">sga.gateway.operation</field>
    <field name="arch" type="xml">
      <list create="true" delete="false">
        <field name="name"/><field name="action"/><field name="revision"/>
        <field name="company_id"/><field name="state"/><field name="last_error"/><field name="last_checked"/>
      </list>
    </field>
  </record>
  <record id="view_sga_gateway_operation_form" model="ir.ui.view">
    <field name="name">sga.gateway.operation.form</field>
    <field name="model">sga.gateway.operation</field>
    <field name="arch" type="xml">
      <form delete="false">
        <header>
          <button name="action_queue" type="object" string="Enviar ahora" class="oe_highlight" invisible="state != 'BORRADOR'"/>
          <button name="action_refresh" type="object" string="Consultar / recuperar" invisible="state == 'BORRADOR'"/>
          <field name="state"/>
        </header>
        <sheet>
          <group>
            <field name="name"/><field name="company_id" readonly="state != 'BORRADOR'"/>
            <field name="target_company_key" readonly="state != 'BORRADOR'"/>
            <field name="action" readonly="state != 'BORRADOR'"/><field name="revision" readonly="state != 'BORRADOR'"/>
            <field name="aggregate_uuid" readonly="state != 'BORRADOR'"/>
            <field name="expected_target_fingerprint" readonly="state != 'BORRADOR'"/>
          </group>
          <group string="Contenido de integración"><field name="payload" readonly="state != 'BORRADOR'"/></group>
          <group string="Seguimiento"><field name="submitted_by"/><field name="queued_at"/><field name="gateway_id"/>
            <field name="native_keys"/><field name="last_error"/><field name="last_checked"/>
            <field name="operation_uuid"/><field name="event_uuid"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_sga_gateway_operations" model="ir.actions.act_window">
    <field name="name">Operaciones del gateway</field><field name="res_model">sga.gateway.operation</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_sga_gateway" name="Integración SGA" groups="base.group_system"/>
  <menuitem id="menu_sga_gateway_operations" name="Operaciones" parent="menu_sga_gateway" action="action_sga_gateway_operations"/>
</odoo>
